{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": true,
    "rootDirs": ["./src", "./test"],
    "outDir": "./build",
    "esModuleInterop": true,
    "strict": true,
    "resolveJsonModule": true,
    "inlineSourceMap": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "ts-node": {
    // ts-node only compiles files reachable from the entry point's imports, so
    // ambient declarations like src/types.d.ts (the Express.Request `context`
    // augmentation) are otherwise skipped under `npm run dev`. `files: true`
    // makes ts-node load tsconfig's files/include set at startup, the same way
    // `tsc` does, so the augmentation is applied.
    "files": true
  }
}
